#!/bin/bash
#PBS -N matmul_1node_par128
#PBS -q par128
#PBS -l nodes=1:ppn=128
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o bench_1node.log

cd $PBS_O_WORKDIR

source ~/spack/share/spack/setup-env.sh
spack env activate cenapad_challenge2

EXEC="./build/matmul_bench"
OUT_CSV="benchmark_results.csv"

REPS=3
N=4000
BS=256

echo "=== EXPERIMENTO EM 1 NÓ COMPLETO (par128 - 128 CORES) ==="
for NP in 16 32 64 128; do
    export OPENBLAS_NUM_THREADS=1
    mpirun -np $NP $EXEC -n $N -b $BS -m mpi -t 1 -r $REPS | grep "^CSV" >> $OUT_CSV
    mpirun -np $NP $EXEC -n $N -b $BS -m blas -t 1 -r $REPS | grep "^CSV" >> $OUT_CSV
done